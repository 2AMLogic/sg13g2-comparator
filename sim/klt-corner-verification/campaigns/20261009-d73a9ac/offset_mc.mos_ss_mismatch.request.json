{
  "_comment": [
    "sg13g2-comparator -- klt sim request, bench `offset_mc` (issue #62).",
    "GENERATED by `python3 sim/run_klt_corner_verification.py build`; the",
    "committed copy is byte-for-byte what was submitted.",
    "Whole-latch input-referred offset, one mismatch draw per klt sim Monte-Carlo sample, N = 60 per PVT point -- DR-0002 Row 1.",
    "limits encode DR-0002 TARGET bounds and validity gates only; Stretch",
    "verdicts are graded by sim/kltsim/grade.py from the same per-corner",
    "values (see sim/kltsim/benches.py)."
  ],
  "engine": "ngspice",
  "netlist": "offset_mc.body.spice",
  "netlist_source": "schematic",
  "backend": "batch",
  "models": {
    "pdk": "ihp-sg13g2",
    "lib": "libs.tech/ngspice/models/cornerMOSlv.lib"
  },
  "corners": {
    "process": [
      "mos_ss_mismatch"
    ],
    "supply_v": {
      "vsup": [
        1.08,
        1.2,
        1.32
      ]
    },
    "temperature_c": [
      -40,
      27,
      125
    ]
  },
  "analysis": {
    "kind": "tran",
    "args": "100p 990n"
  },
  "measurements": [
    {
      "name": "vdd_meas",
      "spice": ".meas tran vdd_meas find v(vdd) at=5n",
      "unit": "V"
    },
    {
      "name": "temp_meas",
      "spice": ".meas tran temp_meas find v(tcheck) at=1n",
      "unit": "C"
    },
    {
      "name": "vbias_mv",
      "spice": ".meas tran vbias_mv find par('v(ibn)*1e3') at=5n",
      "unit": "mV"
    },
    {
      "name": "lowcount",
      "spice": ".meas tran lowcount param='33-(dlev0+dlev1+dlev2+dlev3+dlev4+dlev5+dlev6+dlev7+dlev8+dlev9+dlev10+dlev11+dlev12+dlev13+dlev14+dlev15+dlev16+dlev17+dlev18+dlev19+dlev20+dlev21+dlev22+dlev23+dlev24+dlev25+dlev26+dlev27+dlev28+dlev29+dlev30+dlev31+dlev32)'",
      "unit": "levels",
      "limits": {
        "min": 0.5,
        "max": 32.5
      }
    },
    {
      "name": "vos_mv",
      "spice": ".meas tran vos_mv param='(-0.048+(lowcount-0.5)*0.003)*1e3'",
      "unit": "mV",
      "limits": {
        "min": -15.0,
        "max": 15.0
      },
      "k_sigma": 3.0
    }
  ],
  "options": {
    "timeout_s": 300,
    "keep_artifacts": true
  },
  "monte_carlo": {
    "n": 60,
    "seed": 20260916,
    "vary": "mismatch",
    "quantiles": [
      0.135,
      50,
      99.865
    ]
  }
}
