{
  "_comment": [
    "sg13g2-comparator -- klt sim request, bench `regeneration` (issue #62).",
    "GENERATED by `python3 sim/run_klt_corner_verification.py build`; the",
    "committed copy is byte-for-byte what was submitted.",
    "Decision time at 50 mV / 1 mV / 0.1 mV overdrive, regeneration time constant tau, and average power over one 30 ns (33.3 MHz) cycle including the tail-bias reference branch -- DR-0002 Rows 3 and 5.",
    "limits encode DR-0002 TARGET bounds and validity gates only; Stretch",
    "verdicts are graded by sim/kltsim/grade.py from the same per-corner",
    "values (see sim/kltsim/benches.py)."
  ],
  "engine": "ngspice",
  "netlist": "regeneration.body.spice",
  "netlist_source": "schematic",
  "backend": "batch",
  "models": {
    "pdk": "ihp-sg13g2",
    "lib": "libs.tech/ngspice/models/cornerMOSlv.lib"
  },
  "corners": {
    "process": [
      "mos_tt",
      "mos_ff",
      "mos_ss",
      "mos_fs",
      "mos_sf"
    ],
    "supply_v": {
      "vsup": [
        1.08,
        1.2,
        1.32
      ],
      "vsupa": [
        1.08,
        1.2,
        1.32
      ]
    },
    "temperature_c": [
      -40,
      27,
      125
    ]
  },
  "analysis": {
    "kind": "tran",
    "args": "5p 60n"
  },
  "measurements": [
    {
      "name": "vdd_meas",
      "spice": ".meas tran vdd_meas find v(vdd) at=25n",
      "unit": "V"
    },
    {
      "name": "vdda_meas",
      "spice": ".meas tran vdda_meas find v(vdda) at=25n",
      "unit": "V"
    },
    {
      "name": "temp_meas",
      "spice": ".meas tran temp_meas find v(tcheck) at=1n",
      "unit": "C"
    },
    {
      "name": "td_a",
      "spice": ".meas tran td_a trig v(clkn) val=0.5 rise=2 targ v(dan) val=0.5 rise=1 td=35n",
      "unit": "s"
    },
    {
      "name": "td_b",
      "spice": ".meas tran td_b trig v(clkn) val=0.5 rise=2 targ v(dbn) val=0.5 rise=1 td=35n",
      "unit": "s"
    },
    {
      "name": "td_c",
      "spice": ".meas tran td_c trig v(clkn) val=0.5 rise=2 targ v(dcn) val=0.5 rise=1 td=35n",
      "unit": "s"
    },
    {
      "name": "dout_od50_first",
      "spice": ".meas tran dout_od50_first find v(dan) at=18n",
      "unit": "V/V",
      "limits": {
        "max": 0.1
      }
    },
    {
      "name": "dout_od1_first",
      "spice": ".meas tran dout_od1_first find v(dbn) at=18n",
      "unit": "V/V",
      "limits": {
        "max": 0.1
      }
    },
    {
      "name": "dout_od01_first",
      "spice": ".meas tran dout_od01_first find v(dcn) at=18n",
      "unit": "V/V",
      "limits": {
        "max": 0.1
      }
    },
    {
      "name": "dout_od50_end",
      "spice": ".meas tran dout_od50_end find v(dan) at=55n",
      "unit": "V/V",
      "limits": {
        "min": 0.9
      }
    },
    {
      "name": "dout_od1_end",
      "spice": ".meas tran dout_od1_end find v(dbn) at=55n",
      "unit": "V/V",
      "limits": {
        "min": 0.9
      }
    },
    {
      "name": "dout_od01_end",
      "spice": ".meas tran dout_od01_end find v(dcn) at=55n",
      "unit": "V/V",
      "limits": {
        "min": 0.9
      }
    },
    {
      "name": "td_od50_ns",
      "spice": ".meas tran td_od50_ns param='td_a*1e9'",
      "unit": "ns",
      "limits": {
        "max": 1.5
      }
    },
    {
      "name": "td_od1_ns",
      "spice": ".meas tran td_od1_ns param='td_b*1e9'",
      "unit": "ns"
    },
    {
      "name": "td_od01_ns",
      "spice": ".meas tran td_od01_ns param='td_c*1e9'",
      "unit": "ns",
      "limits": {
        "max": 2.0
      }
    },
    {
      "name": "tau_ps",
      "spice": ".meas tran tau_ps param='(td_c-td_b)/2.302585093*1e12'",
      "unit": "ps",
      "limits": {
        "max": 250.0
      }
    },
    {
      "name": "resolve_decades",
      "spice": ".meas tran resolve_decades param='td_b/((td_c-td_b)/2.302585093)'",
      "unit": "1"
    },
    {
      "name": "i_stat",
      "spice": ".meas tran i_stat avg i(vsupa) from=25n to=29n",
      "unit": "A"
    },
    {
      "name": "i_static_ua",
      "spice": ".meas tran i_static_ua param='abs(i_stat)*1e6'",
      "unit": "uA"
    },
    {
      "name": "p_avg",
      "spice": ".meas tran p_avg avg par('-v(vdda)*i(vsupa)') from=30n to=60n",
      "unit": "W"
    },
    {
      "name": "p_avg_uw",
      "spice": ".meas tran p_avg_uw param='p_avg*1e6'",
      "unit": "uW"
    },
    {
      "name": "vref_v",
      "spice": ".meas tran vref_v find v(ibna) at=5n",
      "unit": "V"
    },
    {
      "name": "tmid_eval_v",
      "spice": ".meas tran tmid_eval_v find v(xa.x1.tmid) at=10.4n",
      "unit": "V"
    }
  ],
  "options": {
    "timeout_s": 600,
    "keep_artifacts": true
  }
}
