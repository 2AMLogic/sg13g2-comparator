{
  "_comment": [
    "sg13g2-comparator -- klt sim request, bench `tn_full_int_x8` (issue #62).",
    "GENERATED by `python3 sim/run_klt_corner_verification.py build`; the",
    "committed copy is byte-for-byte what was submitted.",
    "Issue #81 sensitivity (NOT a spec config): internal noise only, every internal density scaled x8, so the +/-od_x rungs are no longer saturated and the internal term can be MEASURED; sigma_int(1x) is read as sigma(8x)/8 under the linear-scaling assumption checked by the x4 run.",
    "limits encode DR-0002 TARGET bounds and validity gates only; Stretch",
    "verdicts are graded by sim/kltsim/grade.py from the same per-corner",
    "values (see sim/kltsim/benches.py)."
  ],
  "engine": "ngspice",
  "netlist": "tn_full_int_x8.body.spice",
  "netlist_source": "schematic",
  "backend": "batch",
  "models": {
    "pdk": "ihp-sg13g2",
    "lib": "libs.tech/ngspice/models/cornerMOSlv.lib"
  },
  "corners": {
    "process": [
      "mos_fs"
    ],
    "supply_v": {
      "vsup": [
        1.08,
        1.2,
        1.32
      ]
    },
    "temperature_c": [
      -40,
      27,
      125
    ]
  },
  "analysis": {
    "kind": "tran",
    "args": "20p 5.1n 0 20p"
  },
  "measurements": [
    {
      "name": "vdd_meas",
      "spice": ".meas tran vdd_meas find v(vdd) at=0.5n",
      "unit": "V"
    },
    {
      "name": "temp_meas",
      "spice": ".meas tran temp_meas find v(tcheck) at=0.5n",
      "unit": "C"
    },
    {
      "name": "vn0_a",
      "spice": ".meas tran vn0_a find v(inz_x0_xm3) at=0.5n",
      "unit": "V"
    },
    {
      "name": "vn0_b",
      "spice": ".meas tran vn0_b find v(inz_x0_xm3) at=2.5n",
      "unit": "V"
    },
    {
      "name": "vn1_a",
      "spice": ".meas tran vn1_a find v(inz_x1_xm3) at=0.5n",
      "unit": "V"
    },
    {
      "name": "d_zero",
      "spice": ".meas tran d_zero find v(dn0) at=5n",
      "unit": "V/V"
    },
    {
      "name": "d_plus",
      "spice": ".meas tran d_plus find v(dn1) at=5n",
      "unit": "V/V"
    },
    {
      "name": "d_minus",
      "spice": ".meas tran d_minus find v(dn2) at=5n",
      "unit": "V/V"
    },
    {
      "name": "res_zero",
      "spice": ".meas tran res_zero param='abs(d_zero-0.5)'",
      "unit": "V/V",
      "limits": {
        "min": 0.4
      }
    },
    {
      "name": "res_plus",
      "spice": ".meas tran res_plus param='abs(d_plus-0.5)'",
      "unit": "V/V",
      "limits": {
        "min": 0.4
      }
    },
    {
      "name": "res_minus",
      "spice": ".meas tran res_minus param='abs(d_minus-0.5)'",
      "unit": "V/V",
      "limits": {
        "min": 0.4
      }
    },
    {
      "name": "hit_zero",
      "spice": ".meas tran hit_zero find v(h0) at=5n",
      "unit": "1"
    },
    {
      "name": "hit_plus",
      "spice": ".meas tran hit_plus find v(h1) at=5n",
      "unit": "1"
    },
    {
      "name": "hit_minus",
      "spice": ".meas tran hit_minus find v(h2) at=5n",
      "unit": "1"
    }
  ],
  "options": {
    "timeout_s": 300,
    "keep_artifacts": true
  },
  "monte_carlo": {
    "n": 80,
    "seed": 20260916,
    "vary": "mismatch"
  }
}
