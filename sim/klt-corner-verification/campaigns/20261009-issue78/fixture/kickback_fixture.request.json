{
  "_comment": [
    "sg13g2-comparator -- klt sim request, fixture `kickback_fixture` (issue #78).",
    "GENERATED by `python3 sim/run_klt_corner_verification.py build`; the",
    "committed copy is byte-for-byte what was submitted.",
    "Known-charge validation of the Q_kick instrument: unipolar, negative, bipolar (zero net, nonzero peak) and restoring-resistor injections through the kickback bench's own ammeter+integrator block -- DR-0002 Row 4 instrument validation (issue #78). No DUT.",
    "limits encode DR-0002 TARGET bounds and validity gates only; Stretch",
    "verdicts are graded by sim/kltsim/grade.py from the same per-corner",
    "values (see sim/kltsim/benches.py)."
  ],
  "engine": "ngspice",
  "netlist": "kickback_fixture.body.spice",
  "netlist_source": "schematic",
  "backend": "local",
  "models": {
    "pdk": "ihp-sg13g2",
    "lib": "libs.tech/ngspice/models/cornerMOSlv.lib"
  },
  "corners": {
    "process": [
      "mos_tt"
    ],
    "supply_v": {
      "vsup": [
        1.2
      ]
    },
    "temperature_c": [
      27
    ]
  },
  "analysis": {
    "kind": "tran",
    "args": "5p 60n"
  },
  "measurements": [
    {
      "name": "qa29",
      "spice": ".meas tran qa29 find v(qa) at=29n",
      "unit": "V"
    },
    {
      "name": "qamax",
      "spice": ".meas tran qamax max v(qa) from=30n to=45n",
      "unit": "V"
    },
    {
      "name": "qamin",
      "spice": ".meas tran qamin min v(qa) from=30n to=45n",
      "unit": "V"
    },
    {
      "name": "qkick_a_fc",
      "spice": ".meas tran qkick_a_fc param='max(abs(qamax-qa29),abs(qamin-qa29))*1e3'",
      "unit": "fC"
    },
    {
      "name": "qaend",
      "spice": ".meas tran qaend find v(qa) at=45n",
      "unit": "V"
    },
    {
      "name": "qpos_a_fc",
      "spice": ".meas tran qpos_a_fc param='(qamax-qa29)*1e3'",
      "unit": "fC"
    },
    {
      "name": "qneg_a_fc",
      "spice": ".meas tran qneg_a_fc param='(qamin-qa29)*1e3'",
      "unit": "fC"
    },
    {
      "name": "qnet_a_fc",
      "spice": ".meas tran qnet_a_fc param='(qaend-qa29)*1e3'",
      "unit": "fC"
    },
    {
      "name": "qb29",
      "spice": ".meas tran qb29 find v(qb) at=29n",
      "unit": "V"
    },
    {
      "name": "qbmax",
      "spice": ".meas tran qbmax max v(qb) from=30n to=45n",
      "unit": "V"
    },
    {
      "name": "qbmin",
      "spice": ".meas tran qbmin min v(qb) from=30n to=45n",
      "unit": "V"
    },
    {
      "name": "qkick_b_fc",
      "spice": ".meas tran qkick_b_fc param='max(abs(qbmax-qb29),abs(qbmin-qb29))*1e3'",
      "unit": "fC"
    },
    {
      "name": "qbend",
      "spice": ".meas tran qbend find v(qb) at=45n",
      "unit": "V"
    },
    {
      "name": "qpos_b_fc",
      "spice": ".meas tran qpos_b_fc param='(qbmax-qb29)*1e3'",
      "unit": "fC"
    },
    {
      "name": "qneg_b_fc",
      "spice": ".meas tran qneg_b_fc param='(qbmin-qb29)*1e3'",
      "unit": "fC"
    },
    {
      "name": "qnet_b_fc",
      "spice": ".meas tran qnet_b_fc param='(qbend-qb29)*1e3'",
      "unit": "fC"
    },
    {
      "name": "qc29",
      "spice": ".meas tran qc29 find v(qc) at=29n",
      "unit": "V"
    },
    {
      "name": "qcmax",
      "spice": ".meas tran qcmax max v(qc) from=30n to=45n",
      "unit": "V"
    },
    {
      "name": "qcmin",
      "spice": ".meas tran qcmin min v(qc) from=30n to=45n",
      "unit": "V"
    },
    {
      "name": "qkick_c_fc",
      "spice": ".meas tran qkick_c_fc param='max(abs(qcmax-qc29),abs(qcmin-qc29))*1e3'",
      "unit": "fC"
    },
    {
      "name": "qcend",
      "spice": ".meas tran qcend find v(qc) at=45n",
      "unit": "V"
    },
    {
      "name": "qpos_c_fc",
      "spice": ".meas tran qpos_c_fc param='(qcmax-qc29)*1e3'",
      "unit": "fC"
    },
    {
      "name": "qneg_c_fc",
      "spice": ".meas tran qneg_c_fc param='(qcmin-qc29)*1e3'",
      "unit": "fC"
    },
    {
      "name": "qnet_c_fc",
      "spice": ".meas tran qnet_c_fc param='(qcend-qc29)*1e3'",
      "unit": "fC"
    },
    {
      "name": "qd29",
      "spice": ".meas tran qd29 find v(qd) at=29n",
      "unit": "V"
    },
    {
      "name": "qdmax",
      "spice": ".meas tran qdmax max v(qd) from=30n to=45n",
      "unit": "V"
    },
    {
      "name": "qdmin",
      "spice": ".meas tran qdmin min v(qd) from=30n to=45n",
      "unit": "V"
    },
    {
      "name": "qkick_d_fc",
      "spice": ".meas tran qkick_d_fc param='max(abs(qdmax-qd29),abs(qdmin-qd29))*1e3'",
      "unit": "fC"
    },
    {
      "name": "qdend",
      "spice": ".meas tran qdend find v(qd) at=45n",
      "unit": "V"
    },
    {
      "name": "qpos_d_fc",
      "spice": ".meas tran qpos_d_fc param='(qdmax-qd29)*1e3'",
      "unit": "fC"
    },
    {
      "name": "qneg_d_fc",
      "spice": ".meas tran qneg_d_fc param='(qdmin-qd29)*1e3'",
      "unit": "fC"
    },
    {
      "name": "qnet_d_fc",
      "spice": ".meas tran qnet_d_fc param='(qdend-qd29)*1e3'",
      "unit": "fC"
    },
    {
      "name": "vpk_d_v",
      "spice": ".meas tran vpk_d_v max v(apd) from=30n to=45n",
      "unit": "V"
    },
    {
      "name": "vcest_d_fc",
      "spice": ".meas tran vcest_d_fc param='vpk_d_v*100'",
      "unit": "fC"
    }
  ],
  "options": {
    "timeout_s": 300,
    "keep_artifacts": true
  }
}
