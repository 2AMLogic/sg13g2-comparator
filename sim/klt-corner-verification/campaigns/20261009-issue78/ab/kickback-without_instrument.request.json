{
  "_comment": [
    "sg13g2-comparator -- klt sim request, bench `kickback` (issue #62).",
    "GENERATED by `python3 sim/run_klt_corner_verification.py build`; the",
    "committed copy is byte-for-byte what was submitted.",
    "Branch-A (1 kohm / 100 fF) peak transient injected charge Q_kick measured directly, signal-dependent differential residue against a non-restoring 1 Gohm / 1 pF source, and the reported peak excursion -- DR-0002 Row 4.",
    "limits encode DR-0002 TARGET bounds and validity gates only; Stretch",
    "verdicts are graded by sim/kltsim/grade.py from the same per-corner",
    "values (see sim/kltsim/benches.py).",
    "DECISIONS A/B arm `without_instrument` (issue #78): one unit, mos_tt / 1.2 V / 27 C, batch. Not spec evidence."
  ],
  "engine": "ngspice",
  "netlist": "kickback-without_instrument.body.spice",
  "netlist_source": "schematic",
  "backend": "batch",
  "models": {
    "pdk": "ihp-sg13g2",
    "lib": "libs.tech/ngspice/models/cornerMOSlv.lib"
  },
  "corners": {
    "process": [
      "mos_tt"
    ],
    "supply_v": {
      "vsup": [
        1.2
      ]
    },
    "temperature_c": [
      27
    ]
  },
  "analysis": {
    "kind": "tran",
    "args": "5p 60n"
  },
  "measurements": [
    {
      "name": "vdd_meas",
      "spice": ".meas tran vdd_meas find v(vdd) at=25n",
      "unit": "V"
    },
    {
      "name": "temp_meas",
      "spice": ".meas tran temp_meas find v(tcheck) at=1n",
      "unit": "C"
    },
    {
      "name": "ad_pos",
      "spice": ".meas tran ad_pos max v(ad) from=30n to=45n",
      "unit": "V"
    },
    {
      "name": "ad_neg",
      "spice": ".meas tran ad_neg min v(ad) from=30n to=45n",
      "unit": "V"
    },
    {
      "name": "kick_1k_peak_mv",
      "spice": ".meas tran kick_1k_peak_mv param='max(abs(ad_pos),abs(ad_neg))*1e3'",
      "unit": "mV"
    },
    {
      "name": "kick_1k_pos_mv",
      "spice": ".meas tran kick_1k_pos_mv param='ad_pos*1e3'",
      "unit": "mV"
    },
    {
      "name": "kick_1k_neg_mv",
      "spice": ".meas tran kick_1k_neg_mv param='ad_neg*1e3'",
      "unit": "mV"
    },
    {
      "name": "bd0",
      "spice": ".meas tran bd0 find v(bd) at=29n",
      "unit": "V"
    },
    {
      "name": "bd1",
      "spice": ".meas tran bd1 find v(bd) at=55n",
      "unit": "V"
    },
    {
      "name": "cd0",
      "spice": ".meas tran cd0 find v(cd) at=29n",
      "unit": "V"
    },
    {
      "name": "cd1",
      "spice": ".meas tran cd1 find v(cd) at=55n",
      "unit": "V"
    },
    {
      "name": "kick_sigdep_uv",
      "spice": ".meas tran kick_sigdep_uv param='abs((cd1-cd0)-(bd1-bd0))*1e6'",
      "unit": "uV",
      "limits": {
        "max": 100.0
      }
    },
    {
      "name": "bc0",
      "spice": ".meas tran bc0 find v(bc) at=29n",
      "unit": "V"
    },
    {
      "name": "bc1",
      "spice": ".meas tran bc1 find v(bc) at=55n",
      "unit": "V"
    },
    {
      "name": "kick_cm_uv",
      "spice": ".meas tran kick_cm_uv param='(bc1-bc0)*1e6'",
      "unit": "uV"
    },
    {
      "name": "dout_1k_end",
      "spice": ".meas tran dout_1k_end find v(dan) at=55n",
      "unit": "V/V",
      "limits": {
        "min": 0.9
      }
    },
    {
      "name": "dout_float_small_end",
      "spice": ".meas tran dout_float_small_end find v(dbn) at=55n",
      "unit": "V/V",
      "limits": {
        "min": 0.9
      }
    },
    {
      "name": "dout_float_big_end",
      "spice": ".meas tran dout_float_big_end find v(dcn) at=55n",
      "unit": "V/V",
      "limits": {
        "min": 0.9
      }
    }
  ],
  "options": {
    "timeout_s": 900,
    "keep_artifacts": true
  }
}
