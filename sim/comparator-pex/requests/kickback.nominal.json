{
  "engine": "ngspice",
  "netlist": "../dut/tb_kickback.sp",
  "netlist_source": "schematic",
  "models": {
    "pdk": "ihp-sg13g2",
    "lib": "libs.tech/ngspice/models/cornerMOSlv.lib"
  },
  "corners": {
    "process": [
      {
        "name": "tt",
        "sections": [
          "mos_tt"
        ]
      }
    ],
    "supply_v": {
      "vdd_val": [
        1.2
      ]
    },
    "temperature_c": [
      27
    ]
  },
  "analysis": {
    "kind": "tran",
    "args": "5p 60n"
  },
  "measurements": [
    {
      "name": "ad_pos",
      "spice": ".meas tran ad_pos max v(ad) from=30n to=45n"
    },
    {
      "name": "ad_neg",
      "spice": ".meas tran ad_neg min v(ad) from=30n to=45n"
    },
    {
      "name": "ap0",
      "spice": ".meas tran ap0 find v(apa) at=29n"
    },
    {
      "name": "apmax",
      "spice": ".meas tran apmax max v(apa) from=30n to=45n"
    },
    {
      "name": "apmin",
      "spice": ".meas tran apmin min v(apa) from=30n to=45n"
    },
    {
      "name": "bd0",
      "spice": ".meas tran bd0 find v(bd) at=29n"
    },
    {
      "name": "bd1",
      "spice": ".meas tran bd1 find v(bd) at=55n"
    },
    {
      "name": "cd0",
      "spice": ".meas tran cd0 find v(cd) at=29n"
    },
    {
      "name": "cd1",
      "spice": ".meas tran cd1 find v(cd) at=55n"
    },
    {
      "name": "bc0",
      "spice": ".meas tran bc0 find v(bc) at=29n"
    },
    {
      "name": "bc1",
      "spice": ".meas tran bc1 find v(bc) at=55n"
    },
    {
      "name": "bp0",
      "spice": ".meas tran bp0 find v(bpp) at=29n"
    },
    {
      "name": "bn0",
      "spice": ".meas tran bn0 find v(bpn) at=29n"
    },
    {
      "name": "bp1",
      "spice": ".meas tran bp1 find v(bpp) at=55n"
    },
    {
      "name": "bn1",
      "spice": ".meas tran bn1 find v(bpn) at=55n"
    },
    {
      "name": "da_end",
      "spice": ".meas tran da_end find v(dan) at=55n"
    },
    {
      "name": "db_end",
      "spice": ".meas tran db_end find v(dbn) at=55n"
    },
    {
      "name": "dc_end",
      "spice": ".meas tran dc_end find v(dcn) at=55n"
    }
  ],
  "options": {
    "osdi_preload": [
      "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/osdi/psp103.osdi",
      "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/osdi/psp103_nqs.osdi",
      "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/osdi/r3_cmc.osdi",
      "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/osdi/mosvar.osdi"
    ],
    "timeout_s": 3600,
    "keep_artifacts": false
  }
}
