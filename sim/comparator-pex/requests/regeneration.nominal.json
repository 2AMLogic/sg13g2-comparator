{
  "engine": "ngspice",
  "netlist": "../dut/tb_regeneration.sp",
  "netlist_source": "schematic",
  "models": {
    "pdk": "ihp-sg13g2",
    "lib": "libs.tech/ngspice/models/cornerMOSlv.lib"
  },
  "corners": {
    "process": [
      {
        "name": "tt",
        "sections": [
          "mos_tt"
        ]
      }
    ],
    "supply_v": {
      "vdd_val": [
        1.2
      ]
    },
    "temperature_c": [
      27
    ]
  },
  "analysis": {
    "kind": "tran",
    "args": "5p 60n"
  },
  "measurements": [
    {
      "name": "vsup_v",
      "spice": ".meas tran vsup_v find v(vdd) at=25n"
    },
    {
      "name": "td_a",
      "spice": ".meas tran td_a trig v(clkn) val=0.5 rise=2 targ v(dan) val=0.5 rise=1 td=35n"
    },
    {
      "name": "td_b",
      "spice": ".meas tran td_b trig v(clkn) val=0.5 rise=2 targ v(dbn) val=0.5 rise=1 td=35n"
    },
    {
      "name": "td_c",
      "spice": ".meas tran td_c trig v(clkn) val=0.5 rise=2 targ v(dcn) val=0.5 rise=1 td=35n"
    },
    {
      "name": "da_first",
      "spice": ".meas tran da_first find v(dan) at=18n"
    },
    {
      "name": "db_first",
      "spice": ".meas tran db_first find v(dbn) at=18n"
    },
    {
      "name": "dc_first",
      "spice": ".meas tran dc_first find v(dcn) at=18n"
    },
    {
      "name": "da_end",
      "spice": ".meas tran da_end find v(dan) at=55n"
    },
    {
      "name": "db_end",
      "spice": ".meas tran db_end find v(dbn) at=55n"
    },
    {
      "name": "dc_end",
      "spice": ".meas tran dc_end find v(dcn) at=55n"
    },
    {
      "name": "i_stat",
      "spice": ".meas tran i_stat avg i(vsupa) from=25n to=29n"
    },
    {
      "name": "q_dec",
      "spice": ".meas tran q_dec integ i(vsupa) from=39.9n to=48n"
    }
  ],
  "options": {
    "osdi_preload": [
      "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/osdi/psp103.osdi",
      "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/osdi/psp103_nqs.osdi",
      "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/osdi/r3_cmc.osdi",
      "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/osdi/mosvar.osdi"
    ],
    "timeout_s": 3600,
    "keep_artifacts": false
  }
}
