{
  "_comment": [
    "sg13g2-comparator -- klt sim request, clock/supply sensitivity `regen` condition `strobe-5n` (issue #173).",
    "GENERATED by `python3 sim/run_clock_supply_sensitivity.py build`; the committed copy is byte-for-byte what was submitted.",
    "CHARACTERIZATION (issue #173), condition strobe-5n (5 ns strobe): decision time at 50 mV / 1 mV / 0.1 mV overdrive, tau and decision-polarity gates over the ratified 45-point PVT grid. Not a DR-0002 compliance measurement.",
    "Measurement limits on the DR-0002 spec rows are dropped (characterization); decision-polarity and range gates are kept."
  ],
  "engine": "ngspice",
  "netlist": "regen.strobe-5n.body.spice",
  "netlist_source": "schematic",
  "backend": "batch",
  "models": {
    "pdk": "ihp-sg13g2",
    "lib": "libs.tech/ngspice/models/cornerMOSlv.lib"
  },
  "corners": {
    "process": [
      "mos_tt",
      "mos_ff",
      "mos_ss",
      "mos_fs",
      "mos_sf"
    ],
    "supply_v": {
      "vsup": [
        1.08,
        1.2,
        1.32
      ],
      "vsupa": [
        1.08,
        1.2,
        1.32
      ]
    },
    "temperature_c": [
      -40,
      27,
      125
    ]
  },
  "analysis": {
    "kind": "tran",
    "args": "5p 60n"
  },
  "measurements": [
    {
      "name": "vdd_meas",
      "spice": ".meas tran vdd_meas find v(vdd) at=25n",
      "unit": "V"
    },
    {
      "name": "vdda_meas",
      "spice": ".meas tran vdda_meas find v(vdda) at=25n",
      "unit": "V"
    },
    {
      "name": "temp_meas",
      "spice": ".meas tran temp_meas find v(tcheck) at=1n",
      "unit": "C"
    },
    {
      "name": "td_a",
      "spice": ".meas tran td_a trig v(clkn) val=0.5 rise=2 targ v(dan) val=0.5 rise=1 td=35n",
      "unit": "s"
    },
    {
      "name": "td_b",
      "spice": ".meas tran td_b trig v(clkn) val=0.5 rise=2 targ v(dbn) val=0.5 rise=1 td=35n",
      "unit": "s"
    },
    {
      "name": "td_c",
      "spice": ".meas tran td_c trig v(clkn) val=0.5 rise=2 targ v(dcn) val=0.5 rise=1 td=35n",
      "unit": "s"
    },
    {
      "name": "dout_od50_first",
      "spice": ".meas tran dout_od50_first find v(dan) at=13n",
      "unit": "V/V",
      "limits": {
        "max": 0.1
      }
    },
    {
      "name": "dout_od1_first",
      "spice": ".meas tran dout_od1_first find v(dbn) at=13n",
      "unit": "V/V",
      "limits": {
        "max": 0.1
      }
    },
    {
      "name": "dout_od01_first",
      "spice": ".meas tran dout_od01_first find v(dcn) at=13n",
      "unit": "V/V",
      "limits": {
        "max": 0.1
      }
    },
    {
      "name": "dout_od50_end",
      "spice": ".meas tran dout_od50_end find v(dan) at=58n",
      "unit": "V/V",
      "limits": {
        "min": 0.9
      }
    },
    {
      "name": "dout_od1_end",
      "spice": ".meas tran dout_od1_end find v(dbn) at=58n",
      "unit": "V/V",
      "limits": {
        "min": 0.9
      }
    },
    {
      "name": "dout_od01_end",
      "spice": ".meas tran dout_od01_end find v(dcn) at=58n",
      "unit": "V/V",
      "limits": {
        "min": 0.9
      }
    },
    {
      "name": "td_od50_ns",
      "spice": ".meas tran td_od50_ns param='td_a*1e9'",
      "unit": "ns"
    },
    {
      "name": "td_od1_ns",
      "spice": ".meas tran td_od1_ns param='td_b*1e9'",
      "unit": "ns"
    },
    {
      "name": "td_od01_ns",
      "spice": ".meas tran td_od01_ns param='td_c*1e9'",
      "unit": "ns"
    },
    {
      "name": "tau_ps",
      "spice": ".meas tran tau_ps param='(td_c-td_b)/2.302585093*1e12'",
      "unit": "ps"
    },
    {
      "name": "resolve_decades",
      "spice": ".meas tran resolve_decades param='td_b/((td_c-td_b)/2.302585093)'",
      "unit": "1"
    }
  ],
  "options": {
    "timeout_s": 600,
    "keep_artifacts": false
  },
  "_condition": {
    "issue": 173,
    "name": "strobe-5n",
    "what": "5 ns strobe",
    "edge_ns": 0.1,
    "strobe_ns": 5.0,
    "vstep_v": 0.0,
    "step_timing": "none",
    "step_start_ns": 5.0,
    "step_hold_ns": 16.0
  }
}
