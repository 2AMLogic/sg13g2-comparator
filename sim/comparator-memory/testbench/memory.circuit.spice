BsP2 sP2 0 v = 'v(cp)*(1-v(sw)) + (v(loP)+2*10000)*1e-6*v(sw)'
EapP2 apP2 cm sP2 0 0.5
EanP2 anP2 cm sP2 0 -0.5
ibP2  vdd ibnP2 dc {dut_ib}
XP2   apP2 anP2 clk ibnP2 doutP2 doutbP2 vdd 0 comparator_dut
BdP2 dP2 0 v = '(v(doutP2)-v(doutbP2))/v(vdd)'
