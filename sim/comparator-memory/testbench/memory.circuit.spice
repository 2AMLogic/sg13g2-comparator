ibP3  vdd ibnP3 dc {dut_ib}
XP3   apP3 anP3 clk ibnP3 doutP3 doutbP3 vdd 0 comparator_dut
BdP3 dP3 0 v = '(v(doutP3)-v(doutbP3))/v(vdd)'
