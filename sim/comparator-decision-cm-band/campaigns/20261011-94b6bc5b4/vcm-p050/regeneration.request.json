{
  "_comment": [
    "sg13g2-comparator -- klt sim request, CM-band decision-time condition `vcm-p050` (issue #164).",
    "GENERATED by `python3 sim/run_decision_cm_band.py build`; the committed copy is byte-for-byte what was submitted.",
    "EVIDENCE FOR DR-0004 (issue #164), condition vcm-p050: decision time at 50 mV / 1 mV / 0.1 mV overdrive and tau at input common mode dut_vcm+50 mV; the issue #62 regeneration bench otherwise unchanged. Graded against the unchanged DR-0002 Row 3 bounds.",
    "Measurements, limits and analysis are the issue #62 regeneration bench's, plus the vcm_meas probe."
  ],
  "engine": "ngspice",
  "netlist": "regeneration.body.spice",
  "netlist_source": "schematic",
  "backend": "batch",
  "models": {
    "pdk": "ihp-sg13g2",
    "lib": "libs.tech/ngspice/models/cornerMOSlv.lib"
  },
  "corners": {
    "process": [
      "mos_tt",
      "mos_ff",
      "mos_ss",
      "mos_fs",
      "mos_sf"
    ],
    "supply_v": {
      "vsup": [
        1.08,
        1.2,
        1.32
      ],
      "vsupa": [
        1.08,
        1.2,
        1.32
      ]
    },
    "temperature_c": [
      -40,
      27,
      125
    ]
  },
  "analysis": {
    "kind": "tran",
    "args": "5p 60n"
  },
  "measurements": [
    {
      "name": "vdd_meas",
      "spice": ".meas tran vdd_meas find v(vdd) at=25n",
      "unit": "V"
    },
    {
      "name": "vdda_meas",
      "spice": ".meas tran vdda_meas find v(vdda) at=25n",
      "unit": "V"
    },
    {
      "name": "temp_meas",
      "spice": ".meas tran temp_meas find v(tcheck) at=1n",
      "unit": "C"
    },
    {
      "name": "td_a",
      "spice": ".meas tran td_a trig v(clkn) val=0.5 rise=2 targ v(dan) val=0.5 rise=1 td=35n",
      "unit": "s"
    },
    {
      "name": "td_b",
      "spice": ".meas tran td_b trig v(clkn) val=0.5 rise=2 targ v(dbn) val=0.5 rise=1 td=35n",
      "unit": "s"
    },
    {
      "name": "td_c",
      "spice": ".meas tran td_c trig v(clkn) val=0.5 rise=2 targ v(dcn) val=0.5 rise=1 td=35n",
      "unit": "s"
    },
    {
      "name": "dout_od50_first",
      "spice": ".meas tran dout_od50_first find v(dan) at=18n",
      "unit": "V/V",
      "limits": {
        "max": 0.1
      }
    },
    {
      "name": "dout_od1_first",
      "spice": ".meas tran dout_od1_first find v(dbn) at=18n",
      "unit": "V/V",
      "limits": {
        "max": 0.1
      }
    },
    {
      "name": "dout_od01_first",
      "spice": ".meas tran dout_od01_first find v(dcn) at=18n",
      "unit": "V/V",
      "limits": {
        "max": 0.1
      }
    },
    {
      "name": "dout_od50_end",
      "spice": ".meas tran dout_od50_end find v(dan) at=55n",
      "unit": "V/V",
      "limits": {
        "min": 0.9
      }
    },
    {
      "name": "dout_od1_end",
      "spice": ".meas tran dout_od1_end find v(dbn) at=55n",
      "unit": "V/V",
      "limits": {
        "min": 0.9
      }
    },
    {
      "name": "dout_od01_end",
      "spice": ".meas tran dout_od01_end find v(dcn) at=55n",
      "unit": "V/V",
      "limits": {
        "min": 0.9
      }
    },
    {
      "name": "td_od50_ns",
      "spice": ".meas tran td_od50_ns param='td_a*1e9'",
      "unit": "ns",
      "limits": {
        "max": 1.5
      }
    },
    {
      "name": "td_od1_ns",
      "spice": ".meas tran td_od1_ns param='td_b*1e9'",
      "unit": "ns"
    },
    {
      "name": "td_od01_ns",
      "spice": ".meas tran td_od01_ns param='td_c*1e9'",
      "unit": "ns",
      "limits": {
        "max": 2.0
      }
    },
    {
      "name": "tau_ps",
      "spice": ".meas tran tau_ps param='(td_c-td_b)/2.302585093*1e12'",
      "unit": "ps",
      "limits": {
        "max": 250.0
      }
    },
    {
      "name": "resolve_decades",
      "spice": ".meas tran resolve_decades param='td_b/((td_c-td_b)/2.302585093)'",
      "unit": "1"
    },
    {
      "name": "i_stat",
      "spice": ".meas tran i_stat avg i(vsupa) from=25n to=29n",
      "unit": "A"
    },
    {
      "name": "i_static_ua",
      "spice": ".meas tran i_static_ua param='abs(i_stat)*1e6'",
      "unit": "uA"
    },
    {
      "name": "p_avg",
      "spice": ".meas tran p_avg avg par('-v(vdda)*i(vsupa)') from=30n to=60n",
      "unit": "W"
    },
    {
      "name": "p_avg_uw",
      "spice": ".meas tran p_avg_uw param='p_avg*1e6'",
      "unit": "uW"
    },
    {
      "name": "vcm_meas",
      "spice": ".meas tran vcm_meas find v(cm) at=5n",
      "unit": "V"
    }
  ],
  "options": {
    "timeout_s": 600,
    "keep_artifacts": true
  },
  "_condition": {
    "issue": 164,
    "name": "vcm-p050",
    "vcm_delta_v": 0.05,
    "vcm_v": 0.65,
    "scope": "evidence for the DR-0004 candidate CM-range row (no ratified range)"
  }
}
